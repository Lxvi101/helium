+
+bool AllowedURL(const GURL& url) {
+  return url.is_valid() && (url.SchemeIsHTTPOrHTTPS() ||
+                            url.SchemeIs("chrome") || url.SchemeIs("helium") ||
+                            url.SchemeIs("about") || url.SchemeIsFile());
+}
+GURL NavigationURL(Profile* profile, const std::string& input) {
+  GURL url = url_formatter::FixupURL(input, std::string());
+  // Text without a scheme, dot, or localhost is a search using the user's
+  // configured search engine. Explicit forbidden schemes are never executed.
+  const bool search =
+      input.find(':') == std::string::npos &&
+      (input.find(' ') != std::string::npos ||
+       (input.find('.') == std::string::npos && input != "localhost"));
+  if (search) {
+    auto* service = TemplateURLServiceFactory::GetForProfile(profile);
+    const auto* provider =
+        service ? service->GetDefaultSearchProvider() : nullptr;
+    if (!provider) {
+      return GURL();
+    }
+    url = GURL(provider->url_ref().ReplaceSearchTerms(
+        TemplateURLRef::SearchTermsArgs(base::UTF8ToUTF16(input)),
+        service->search_terms_data()));
+  }
+  return AllowedURL(url) ? url : GURL();
+}
+
+class ArcSidebarHandler : public content::WebUIMessageHandler,
+                          public TabStripModelObserver {
+ public:
+  explicit ArcSidebarHandler(Browser* browser)
+      : browser_(browser),
+        window_key_(base::NumberToString(browser->GetSessionID().id())) {
+    observation_.Observe(browser_->GetTabStripModel());
+  }
+  ~ArcSidebarHandler() override = default;
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "arcSidebar", base::BindRepeating(&ArcSidebarHandler::Handle,
+                                          base::Unretained(this)));
+  }
+  void OnJavascriptDisallowed() override {
+    weak_factory_.InvalidateWeakPtrs();
+    pending_ = false;
+  }
+  void OnTabStripModelChanged(TabStripModel*,
+                              const TabStripModelChange&,
+                              const TabStripSelectionChange&) override {
+    ScheduleUpdate();
+  }
+  void OnTabChangedAt(tabs::TabInterface*, TabChangeType) override {
+    ScheduleUpdate();
+  }
+  void OnTabStripModelDestroyed(TabStripModel*) override {
+    observation_.Reset();
+    browser_ = nullptr;
+    weak_factory_.InvalidateWeakPtrs();
+  }
+
+ private:
+  void ScheduleUpdate() {
+    if (!browser_ || !IsJavascriptAllowed() || pending_) {
+      return;
+    }
+    pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ArcSidebarHandler::Update, weak_factory_.GetWeakPtr()));
+  }
+  int IndexForId(int id) const {
+    auto* model = browser_->GetTabStripModel();
+    for (int i = 0; i < model->count(); ++i) {
+      if (sessions::SessionTabHelper::IdForTab(model->GetWebContentsAt(i))
+              .id() == id) {
+        return i;
+      }
+    }
+    return -1;
+  }
+  base::DictValue ReadState() const {
+    const auto& workspaces =
+        browser_->GetProfile()->GetPrefs()->GetDict(kArcSidebarState);
+    const auto* state = workspaces.FindDict(window_key_);
+    if (!state && !browser_->GetProfile()->IsOffTheRecord()) {
+      state = workspaces.FindDict("last");
+    }
+    return state ? state->Clone() : base::DictValue();
+  }
+  void Handle(const base::ListValue& args) {
+    if (!browser_ || args.size() != 2 || !args[0].is_string() ||
+        !args[1].is_dict()) {
+      return;
+    }
+    const auto& command = args[0].GetString();
+    const auto& data = args[1].GetDict();
+    if (command == "ready") {
+      AllowJavascript();
+      Update();
+      return;
+    }
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+    if (command == "save") {
+      const auto* state = data.FindDict("state");
+      // Bound persistence, validate the schema envelope, and never write to
+      // another profile. OTR profiles use their own in-memory preference store.
+      std::string json;
+      if (!state || state->FindInt("version") != 1 ||
+          !state->FindList("spaces") || !state->FindList("nodes") ||
+          state->FindList("spaces")->size() > 32 ||
+          state->FindList("nodes")->size() > 5000 ||
+          !base::JSONWriter::Write(*state, &json) ||
+          json.size() > 2 * 1024 * 1024) {
+        return;
+      }
+      auto* prefs = browser_->GetProfile()->GetPrefs();
+      auto workspaces = prefs->GetDict(kArcSidebarState).Clone();
+      workspaces.Set(window_key_, state->Clone());
+      workspaces.Set("last", state->Clone());
+      // Retain a bounded number of recent window workspaces.
+      if (workspaces.size() > 33) {
+        std::string oldest;
+        for (auto item : workspaces) {
+          if (item.first != "last" && item.first != window_key_) {
+            oldest = item.first;
+            break;
+          }
+        }
+        if (!oldest.empty()) {
+          workspaces.Remove(oldest);
+        }
+      }
+      prefs->SetDict(kArcSidebarState, std::move(workspaces));
+      return;
+    }
+    auto* model = browser_->GetTabStripModel();
+    const auto id = data.FindInt("tabId");
+    const int index = id ? IndexForId(*id) : model->active_index();
+    if (command == "activate" && index >= 0) {
+      model->ActivateTabAt(index);
+    } else if (command == "close" && id && index >= 0) {
+      // Closing the final tab can destroy this handler. Do not touch members
+      // after the call; model notifications are already coalesced
+      // asynchronously.
+      model->CloseWebContentsAt(index,
+                                TabCloseTypes::CLOSE_USER_GESTURE |
+                                    TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+      return;
+    } else if (command == "open" || command == "navigate") {
+      const auto* input = data.FindString("url");
+      if (!input || input->size() > 8192) {
+        return;
+      }
+      const GURL url = NavigationURL(browser_->GetProfile(), *input);
+      if (!url.is_valid()) {
+        return;
+      }
+      NavigateParams params(browser_, url, ui::PAGE_TRANSITION_TYPED);
+      params.disposition = command == "open"
+                               ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                               : WindowOpenDisposition::CURRENT_TAB;
+      if (command == "navigate" && index >= 0) {
+        model->ActivateTabAt(index);
+      }
+      Navigate(&params);
+      if (params.navigated_or_inserted_contents) {
+        const auto* node = data.FindString("nodeId");
+        if (node && node->size() <= 128) {
+          params.navigated_or_inserted_contents->SetUserData(
+              &kNodeKey, std::make_unique<NodeData>(*node));
+        }
+      }
+    } else if (command == "back") {
+      if (chrome::CanGoBack(browser_)) {
+        chrome::GoBack(browser_, WindowOpenDisposition::CURRENT_TAB);
+      }
+    } else if (command == "forward") {
+      if (chrome::CanGoForward(browser_)) {
+        chrome::GoForward(browser_, WindowOpenDisposition::CURRENT_TAB);
+      }
+    } else if (command == "reload") {
+      chrome::Reload(browser_, WindowOpenDisposition::CURRENT_TAB);
+    } else if (command == "collapse") {
+      auto* controller = tabs::VerticalTabStripStateController::From(browser_);
+      if (controller) {
+        controller->SetCollapsed(!controller->IsCollapsed());
+      }
+    } else if (command == "settings") {
+      NavigateParams params(browser_, GURL("chrome://settings/"),
+                            ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+      params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+      Navigate(&params);
+    } else if (command == "copyURL") {
+      if (auto* active = model->GetActiveWebContents()) {
+        ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+            .WriteText(base::UTF8ToUTF16(active->GetVisibleURL().spec()));
+      }
+    }
+    ScheduleUpdate();
+  }
+  void Update() {
+    pending_ = false;
+    if (!browser_ || !IsJavascriptAllowed()) {
+      return;
+    }
+    auto* model = browser_->GetTabStripModel();
+    base::DictValue result;
+    result.Set("windowId", browser_->GetSessionID().id());
+    result.Set("state", ReadState());
+    result.Set("canGoBack", chrome::CanGoBack(browser_));
+    result.Set("canGoForward", chrome::CanGoForward(browser_));
+    base::ListValue tabs;
+    for (int i = 0; i < model->count(); ++i) {
+      auto* contents = model->GetWebContentsAt(i);
+      base::DictValue tab;
+      tab.Set("id", sessions::SessionTabHelper::IdForTab(contents).id());
+      tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+      tab.Set("url", contents->GetVisibleURL().spec());
+      tab.Set("active", i == model->active_index());
+      tab.Set("pinned", model->IsTabPinned(i));
+      tab.Set("loading", contents->IsLoading());
+      if (auto* node =
+              static_cast<NodeData*>(contents->GetUserData(&kNodeKey))) {
+        tab.Set("nodeId", node->id);
+      }
+      if (auto* entry = contents->GetController().GetLastCommittedEntry()) {
+        const auto& image = entry->GetFavicon().image;
+        if (!image.IsEmpty()) {
+          auto png = image.As1xPNGBytes();
+          if (png && png->size()) {
+            tab.Set("favicon", "data:image/png;base64," +
+                                   base::Base64Encode(base::span(*png)));
+          }
+        }
+      }
+      tabs.Append(std::move(tab));
+    }
+    result.Set("tabs", std::move(tabs));
+    web_ui()->CallJavascriptFunctionUnsafe("arcSidebar.receive", result);
+  }
+  raw_ptr<Browser> browser_;
+  const std::string window_key_;
+  bool pending_ = false;
+  base::ScopedObservation<TabStripModel, TabStripModelObserver> observation_{
+      this};
+  base::WeakPtrFactory<ArcSidebarHandler> weak_factory_{this};
+};
+}  // namespace
+
+ArcSidebarUI::ArcSidebarUI(content::WebUI* web_ui) : WebUIController(web_ui) {
+  auto* contents = web_ui->GetWebContents();
+  auto* source = content::WebUIDataSource::CreateAndAdd(
+      contents->GetBrowserContext(), "arc-sidebar");
+  source->SetDefaultResource(IDR_HELIUM_ARC_SIDEBAR_HTML);
+  source->AddResourcePath("sidebar.css", IDR_HELIUM_ARC_SIDEBAR_CSS);
+  source->AddResourcePath("sidebar.mjs", IDR_HELIUM_ARC_SIDEBAR_JS);
+  source->AddResourcePath("model.mjs", IDR_HELIUM_ARC_SIDEBAR_MODEL_JS);
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc, "img-src 'self' data:;");
+  if (auto* host =
+          static_cast<BrowserData*>(contents->GetUserData(&kBrowserKey))) {
+    web_ui->AddMessageHandler(
+        std::make_unique<ArcSidebarHandler>(host->browser));
+  }
+}
+ArcSidebarUI::~ArcSidebarUI() = default;
+
+std::unique_ptr<views::WebView> CreateArcSidebar(Browser* browser) {
+  auto view = std::make_unique<views::WebView>(browser->GetProfile());
+  view->GetWebContents()->SetUserData(&kBrowserKey,
+                                      std::make_unique<BrowserData>(browser));
+  view->LoadInitialURL(GURL("chrome://arc-sidebar/"));
+  return view;
+}
+void FocusArcSidebarAddress(views::WebView* view) {
+  view->RequestFocus();
+  if (auto* web_ui = view->GetWebContents()->GetWebUI()) {
+    web_ui->CallJavascriptFunctionUnsafe("arcSidebar.focusAddress");
+  }
+}
