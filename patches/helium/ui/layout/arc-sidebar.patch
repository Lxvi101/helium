+// Only WebContents created by the sidebar host have this capability. Opening
+// chrome://arc-sidebar in a normal tab does not grant access to browser tabs.
+const char kBrowserKey = 0;
+const char kNodeKey = 0;
+class BrowserData : public base::SupportsUserData::Data {
+ public:
